# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Server (Vercel → Settings → Environment Variables), never with a VITE_ prefix:
# Realtime Database URL: Firebase Console → Build → Realtime Database → Data → the URL at the top
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
# Cloudflare R2 (see docs/COST-PLAN.md for the bucket CORS setting)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Character library: lives in the same R2 bucket under lib/v1/ (docs/LIBRARY.md). Only needed if you change the folder:
# LIBRARY_PREFIX=lib/v1
# For `npm run library:pull` (development / tests):
# LIBRARY_SITE=https://your-site.vercel.app

# AI director on Amazon Bedrock (Claude Haiku). Bedrock console -> API keys -> create a (short- or long-term) key. Server only, never VITE_:
AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_REGION=ap-south-1
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
